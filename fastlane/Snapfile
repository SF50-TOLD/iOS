# frozen_string_literal: true

# A list of devices you want to take the screenshots from
# Using devices with App Store Connect accepted screenshot sizes
devices([
    # iPhone - Required sizes
    "iPhone 17 Pro Max",              # 6.7" display (accepted by App Store Connect)
    "iPhone 16e",                     # 6.5" display (covers second tier)

    # iPad - Required sizes
    "iPad Pro 13-inch (M5)",          # 12.9" display (accepted by App Store Connect)
    "iPad Pro 11-inch (M5)"           # 11" display (covers second tier iPad)
])

languages %w[
    en-US
]

# The name of the scheme which contains the UI Tests
scheme "Generate Screenshots"

# Where should the resulting screenshots be stored?
output_directory "./fastlane/screenshots"

# Clear all previously generated screenshots before creating new ones
clear_previous_screenshots true

# Reinstall the app before running tests
reinstall_app true

# Erase simulator before running tests
erase_simulator true

# Set the status bar to 9:41 AM, and show full battery and reception
override_status_bar false

# Stop after first error
stop_after_first_error false

# Number of retries
number_of_retries 1

# Don't test without building
test_without_building false

# Dark mode setting (will be overridden by lane)
dark_mode false

# Launch arguments
launch_arguments [
    "-UITestsEnabled YES"
]

# App identifier
app_identifier "codes.tim.SF50-TOLD"

# Concurrent simulators
concurrent_simulators false

# Output simulator logs
output_simulator_logs true

# Result bundle.
# Disabled so retries work: with a result bundle, snapshot reuses the same
# .xcresult path on a retry and xcodebuild aborts with "Existing file at
# -resultBundlePath" (exit 64), which turns any one-off flake (e.g. a simulator
# "Timed out while loading Accessibility" stall) into a hard device failure
# instead of a recovered retry. The screenshots are copied out regardless.
result_bundle false

# Reuse a single derived-data directory instead of letting snapshot create a
# fresh ~4 GB copy (snapshot_derived-<pid>) on every run/retry and never clean it
# up — those accumulate quickly and fill the disk. The path matches the
# gitignored `DerivedData/` pattern.
derived_data_path "./fastlane/DerivedData"

# For more information about all available options run
# fastlane action snapshot
