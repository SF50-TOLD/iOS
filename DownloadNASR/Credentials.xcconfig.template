// DownloadNASR Credentials Configuration
// Copy this file to Credentials.xcconfig and fill in your values
// See DownloadNASR.docc/Articles/GettingStarted.md for setup instructions

// CloudFlare R2 (required for terrain upload - S3-compatible API)
// Create an R2 API Token at: CloudFlare Dashboard > R2 > Manage R2 API Tokens
// Choose "Object Read & Write" permissions for the sf50-terrain bucket
R2_ACCOUNT_ID =
R2_ACCESS_KEY_ID =
R2_SECRET_ACCESS_KEY =
R2_BUCKET_NAME = sf50-terrain
R2_PUBLIC_URL =

// GitHub (required for nav data upload)
GITHUB_TOKEN =
