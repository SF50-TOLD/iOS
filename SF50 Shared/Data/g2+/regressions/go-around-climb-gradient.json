    "intercept": 5.906422e+00,
    "coefficients": [
      {"features": ["w"], "coefficient": 1.079048e-02},
      {"features": ["a"], "coefficient": -1.099903e+00},
      {"features": ["t"], "coefficient": -8.847584e-01},
      {"features": ["w", "w"], "coefficient": -1.057192e-01},
      {"features": ["w", "a"], "coefficient": -2.604333e-01},
      {"features": ["w", "t"], "coefficient": -2.908171e-01},
      {"features": ["a", "a"], "coefficient": -3.599073e+00},
      {"features": ["a", "t"], "coefficient": 1.033181e+00},
